      "r": 0.303,
      "p": 1.9996372895203518e-18,
      "n": 799
    },
    {
      "variable": "sleep_hours",
      "label": "Total sleep hours",
      "verdict": "primary_lever",
      "why": "The strongest actionable lever in the dataset.",
      "r": 0.237,
      "p": 1.2501539179295815e-11,
      "n": 799
    },
    {
      "variable": "sleep_efficiency_pct",
      "label": "Sleep efficiency %",
      "verdict": "keep_context",
      "why": "Modest independent signal.",
      "r": 0.211,
      "p": 1.5824001199164702e-09,
      "n": 799
    },
    {
      "variable": "deep_sleep_hours",
      "label": "Deep (SWS) hours",
      "verdict": "counterintuitive",
      "why": "Negative correlation \u2014 almost certainly reverse causation (rebound deep sleep after alcohol/strain), not a cause of low HRV.",
      "r": -0.191,
      "p": 5.758885613560058e-08,
      "n": 799
    },
    {
      "variable": "spo2_pct",
      "label": "Blood oxygen %",
      "verdict": "keep_context",
      "why": "Contextual reading, not a control.",
      "r": 0.18,
      "p": 3.2683804817808e-07,
      "n": 798
    },
    {
      "variable": "day_strain",
      "label": "Day strain (same day)",
      "verdict": "wrong_direction",
      "why": "Positive correlation, but the causal arrow runs the other way: a high-HRV morning is what enables a hard day.",
      "r": 0.134,
      "p": 0.00014958295055337382,
      "n": 798
    },
    {
      "variable": "sleep_debt_min",
      "label": "Sleep debt",
      "verdict": "weak_context",
      "why": "Weak; overlaps with sleep hours.",
      "r": -0.123,
      "p": 0.0004781969013906589,
      "n": 799
    },
    {
      "variable": "sleep_consistency_pct",
      "label": "Sleep consistency %",
      "verdict": "weak_lever",
      "why": "Weak univariately and drops to non-significant once sleep hours and alcohol are controlled.",
      "r": 0.12,
      "p": 0.0008311506999035081,
      "n": 775
    },
    {
      "variable": "prior_day_strain",
      "label": "Prior-day strain",
      "verdict": "secondary_lever",
      "why": "Correct causal direction, small effect.",
      "r": -0.073,
      "p": 0.040378073626544095,
      "n": 798
    },
    {
      "variable": "rem_sleep_hours",
      "label": "REM hours",
      "verdict": "no_relationship",
      "why": "No detectable relationship with HRV, despite tracker marketing implying otherwise.",
      "r": -0.052,
      "p": 0.14452779599980953,
      "n": 799
    }
  ],
