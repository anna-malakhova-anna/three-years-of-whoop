      "why": "Partly circular \u2014 WHOOP computes it from asleep duration \u00f7 sleep need, so it overlaps with sleep hours.",
      "r": 0.372,
      "p": 1.0694535890549352e-27,
      "n": 799
    },
    {
      "variable": "resp_rate",
      "label": "Respiratory rate",
      "verdict": "signal_not_lever",
